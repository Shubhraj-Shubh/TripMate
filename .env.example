# =============================================================================
# TripMate - Unified Environment Configuration Reference
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SplitMate Backend (Node.js/Express) -> splitmate-backend/.env
# -----------------------------------------------------------------------------
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/test?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
INTERNAL_API_SECRET=your_internal_api_secret_here
FRONTEND_URL=http://localhost:5173
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# -----------------------------------------------------------------------------
# 2. AI Planner Backend (FastAPI/LangGraph) -> planner-backend/.env
# -----------------------------------------------------------------------------
PORT=8001
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/test?retryWrites=true&w=majority
GEMINI_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_search_api_key_here
RAILRADAR_API_KEY=your_railradar_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
AVIATION_STACK_API_KEY=your_aviation_stack_api_key_here
DEFAULT_ORIGIN_IATA=DEL
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# -----------------------------------------------------------------------------
# 3. AI Assistant Backend (FastAPI/FastMCP/LangChain) -> assistant-backend/.env
# -----------------------------------------------------------------------------
PORT=8002
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/test?retryWrites=true&w=majority
NODE_API_BASE=http://localhost:5000/api
PLANNER_API_BASE=http://localhost:8001/api
GEMINI_API_KEY=your_gemini_api_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# -----------------------------------------------------------------------------
# 4. Frontend (Vite/React) -> frontend/.env
# -----------------------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
