# AI Planner Backend (FastAPI / LangGraph) Environment Configuration
PORT=8001
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/test?retryWrites=true&w=majority
DATABASE_URL=sqlite:///./trip_planner.db

# LLM Providers
GEMINI_API_KEY=your_gemini_api_key_here

# Travel Tool APIs
TAVILY_API_KEY=your_tavily_search_api_key_here
RAILRADAR_API_KEY=your_railradar_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
AVIATION_STACK_API_KEY=your_aviation_stack_api_key_here
DEFAULT_ORIGIN_IATA=DEL

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
